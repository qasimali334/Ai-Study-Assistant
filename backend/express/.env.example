PORT=5000

# Supabase Credentials (Get these from Supabase Project Settings -> API)
SUPABASE_URL=https://your-supabase-url.supabase.co
# Use the service_role key to write to database/storage bypass RLS (secure server-side ONLY)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# FastAPI Engine URL
PYTHON_SERVICE_URL=http://localhost:8000
