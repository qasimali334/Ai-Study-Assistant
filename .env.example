# Supabase Client Variables (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Engine / Python Microservice URL (optional, for RAG embeddings and quiz generation)
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Direct AI Keys (if invoked in Next.js or Python backend)
GROQ_API_KEY=your-groq-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-env
PINECONE_INDEX=examgenie-index
